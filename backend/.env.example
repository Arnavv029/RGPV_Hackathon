# ─── Email (sign-up verification codes) ───────────────────────────────────────
# Real emails are sent only when HOST, USER and PASSWORD are all set; otherwise
# codes are printed to the Django console. For Gmail use a 16-char App Password.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=tiwariarnav460@gmail.com
EMAIL_HOST_PASSWORD=xdwj mlgm tfhf vwwk
# Optional; defaults to "HapticEV <EMAIL_HOST_USER>"
DEFAULT_FROM_EMAIL=HapticEV <hapticev@gmail.com>

# ─── Django / production ──────────────────────────────────────────────────────
# Development defaults work out of the box. For a real deployment set:
#   DJANGO_DEBUG=False
#   DJANGO_SECRET_KEY=<50+ random chars>   (python -c "import secrets;print(secrets.token_urlsafe(50))")
#   DJANGO_ALLOWED_HOSTS=api.yourdomain.com
#   CORS_ALLOWED_ORIGINS=https://yourdomain.com
#   FRONTEND_URL=https://yourdomain.com      (used for links in emails)
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=
CORS_ALLOWED_ORIGINS=
FRONTEND_URL=http://localhost:5173

# Login / sign-up / OTP rate limit per IP
AUTH_THROTTLE_RATE=20/min

# Never enable in production: lets POST /api/bookings/ create "paid" bookings without a gateway.
ALLOW_SIMULATED_PAYMENTS=False

# Optional: PostgreSQL Database URL (Render / Railway / Supabase Postgres)
# Defaults to local SQLite if unset.
# DATABASE_URL=postgresql://user:password@host:5432/dbname
