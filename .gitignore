# ============================================================

.venv/
venv/
env/
ENV/
env.bak/
venv.bak/


# ============================================================
# DJANGO
# ============================================================

*.log

# Local database
db.sqlite3
db.sqlite3-journal

# Django static files generated during deployment
staticfiles/

# Collected static files
static_root/

# Uploaded user media
media/
backend/media/

# Local Django cache
*.sqlite3


