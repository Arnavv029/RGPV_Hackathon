# ============================================================
# CLAUDE / AI TOOLS
# ============================================================

.claude/
.claude/*
.claude.json


# ============================================================
# PYTHON
# ============================================================

__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# Python cache
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.hypothesis/

# Coverage
.coverage
.coverage.*
htmlcov/
.pytest_cache/

# Python build/package files
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/


# ============================================================
